{
  "manifest_version": 3,
  "name": "JDCookie",
  "description": "One click copy cookies to your clipboard",
  "author": "Jerryk",
  "version": "1.1",
  "background": {"service_worker": "background.js"},
  "icons": { "16": "icon_16.png","48": "icon_48.png","128": "icon_128.png" },
  "permissions": [ "cookies", "tabs", "notifications", "clipboardWrite", "clipboardRead", "activeTab", "scripting"],
  "host_permissions": ["http://*/", "https://*/", "<all_urls>"],
  "action": {
    "default_icon": "icon.png",
    "default_title": "点击拷贝Cookie"
  }
}
